# Copy to .env and fill in for local `tcex run` (see ThreatConnect Building Apps: Run).
# https://threatconnect.readme.io/docs/building-apps-tcex-run

# Default org for the API user
API_DEFAULT_ORG=

# ThreatConnect API base URL (include /api if your instance uses it)
TC_API_PATH=https://api.threatconnect.com

# SSL verification (true|false)
TC_VERIFY=true

# Log requests as curl (true|false)
TC_LOG_CURL=false

# Option A: API access ID + secret key
TC_API_ACCESS_ID=
TC_API_SECRET_KEY=

# Option B: development token from ThreatConnect UI (comment out Option A if using this)
# TC_TOKEN=
# TC_TOKEN_EXPIRES=
