{
  "allowOnDemand": true,
  "displayName": "Batch Template",
  "features": [
    "aotExecutionEnabled",
    "appBuilderCompliant",
    "fileParams"
  ],
  "labels": [],
  "languageVersion": "3.11",
  "listDelimiter": "|",
  "note": "A template of a working ingress Organization App.",
  "params": [
    {
      "label": "ThreatConnect Owner",
      "name": "tc_owner",
      "note": "The destination Owner in the ThreatConnect Platform.",
      "required": true,
      "sequence": 1,
      "type": "Choice",
      "validValues": [
        "${OWNERS}"
      ]
    },
    {
      "label": "OTX API Key",
      "name": "otx_api_key",
      "note": "AlienVault OTX API key (X-OTX-API-KEY).",
      "required": true,
      "sequence": 2,
      "type": "String",
      "validValues": [
        "${KEYCHAIN}",
        "${TEXT}"
      ]
    },
    {
      "default": "",
      "label": "Last Modified",
      "name": "last_modified",
      "note": "Optional ISO-8601 datetime for modified_since. Empty uses the last 30 days on first run; subsequent platform runs reuse the value written by the job via results.tc.",
      "required": false,
      "sequence": 3,
      "type": "String"
    },
    {
      "default": "3",
      "label": "ThreatConnect Threat Rating",
      "name": "tc_threat_rating",
      "note": "Threat rating applied to imported indicators (0-5).",
      "required": false,
      "sequence": 4,
      "type": "String"
    },
    {
      "default": "50",
      "label": "ThreatConnect Confidence",
      "name": "tc_confidence",
      "note": "Confidence applied to imported indicators (0-100).",
      "required": false,
      "sequence": 5,
      "type": "String"
    },
    {
      "default": "warning",
      "label": "Logging Level",
      "name": "tc_log_level",
      "sequence": 99,
      "type": "Choice",
      "validValues": [
        "debug",
        "info",
        "warning",
        "error"
      ]
    }
  ],
  "programLanguage": "PYTHON",
  "programMain": "run.py",
  "programVersion": "1.0.0",
  "runtimeLevel": "Organization",
  "sdkVersion": "4.0.0"
}
